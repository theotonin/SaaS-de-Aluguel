# Run Node with --env-file=.env or export variables in the shell.
# Distinct roles: migration owner and restricted runtime.
DATABASE_ADMIN_URL=postgres://loca_owner:change-me@localhost:5432/tonin_loca
DATABASE_URL=postgres://loca_runtime:change-me@localhost:5432/tonin_loca
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set only behind a controlled proxy that overwrites X-Forwarded-For with one client IP.
TRUST_PROXY_ADDRESS=
# Read only by admin:create. Never committed with real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
