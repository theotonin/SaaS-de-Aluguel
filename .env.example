# Copie para .env e substitua pelos dois endereços TCP do painel Prisma.
# Nunca use prefixo VITE_ para credenciais. .env está fora do Git.
DATABASE_PROVIDER=prisma
DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
DIRECT_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
DB_POOL_SIZE=3
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set only behind a controlled proxy that overwrites X-Forwarded-For with one client IP.
TRUST_PROXY_ADDRESS=
# Read only by admin:create. Never committed with real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Superadmin Tonin
