{
  "name": "tonin-loca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "VITE_DEMO=true vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/server.ts",
    "build": "tsc --noEmit && vite build",
    "build:demo": "VITE_DEMO=true npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/server.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
